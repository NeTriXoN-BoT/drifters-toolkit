#include <windows.h>
#include "version.hpp"
101 ICON "../ui/assets/app.ico"
1 RT_MANIFEST "app.manifest"
#ifdef DRIFTER_NEXUS_REVIEWER
1400 DIALOGEX 0, 0, 330, 161
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nexus review connection"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Private review build. Use your own Nexus personal API key to test the official API. Never enter your Nexus password here.", -1, 12, 12, 306, 30
 LTEXT "The key is validated with Nexus and protected for this Windows account in separate review storage. Disconnect in the loader to remove it.", -1, 12, 48, 306, 30
 LTEXT "Your personal API key", -1, 12, 87, 306, 12
 EDITTEXT 1401, 12, 102, 306, 16, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "Connect", IDOK, 194, 132, 60, 17
 PUSHBUTTON "Cancel", IDCANCEL, 258, 132, 60, 17
END
#endif
1 VERSIONINFO
FILEVERSION DRIFTER_VERSION_MAJOR,DRIFTER_VERSION_MINOR,DRIFTER_VERSION_PATCH,0
PRODUCTVERSION DRIFTER_VERSION_MAJOR,DRIFTER_VERSION_MINOR,DRIFTER_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "OkayDude1337\0"
   VALUE "FileDescription", "Drifter's Toolkit - Days Gone Mod Loader\0"
   VALUE "FileVersion", DRIFTER_VERSION
   VALUE "InternalName", "DriftersToolkit\0"
   VALUE "OriginalFilename", "DriftersToolkit.exe\0"
   VALUE "ProductName", "Drifter's Toolkit\0"
   VALUE "ProductVersion", DRIFTER_VERSION
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
