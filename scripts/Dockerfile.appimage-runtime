# Packaging-only toolchain. The payload runtime is built as an ordinary user,
# offline, from the separately SHA-pinned source materials.
FROM alpine@sha256:3c81aa9a3d770b316568f4499e30461a5cd3fbd7180bd89e28e34894c7845832
RUN apk add --no-cache \
    gcc=14.2.0-r4 g++=14.2.0-r4 musl-dev=1.2.5-r11 \
    binutils=2.43.1-r3 make=4.4.1-r2 cmake=3.31.1-r0 \
    samurai=1.2-r6 meson=1.6.1-r0 pkgconf=2.3.0-r0 \
    autoconf=2.72-r0 automake=1.17-r0 libtool=2.4.7-r3 \
    linux-headers=6.6-r1 patch=2.7.6-r10 file=5.46-r2 python3=3.12.15-r0
RUN adduser -D -u 1001 builder
USER builder
WORKDIR /tmp
CMD ["python3"]
