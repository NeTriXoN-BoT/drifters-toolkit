            "USE_64=1",
            "NS_USE_GCC=1",
            "MOZILLA_CLIENT=1",
            "NSS_USE_SYSTEM_SQLITE=1",
            "NSS_DISABLE_DBM=1",
            "NSPR_INCLUDE_DIR={build_prefix}/include/nspr",
            "NSPR_LIB_DIR={build_prefix}/lib",
            "SQLITE_INCLUDE_DIR={build_prefix}/include",
            "SQLITE_LIB_DIR={build_prefix}/lib",
            "DIST={source}/dist",
            "NSS_ENABLE_WERROR=0",
            "OPTIMIZER={cflags}",
            "LDFLAGS={ldflags} $(ARCHFLAG) $(ZDEFS_FLAG)",
            "DSO_LDOPTS=-shared $(LDFLAGS)",
            "SOURCE_PREFIX={source}/dist",
            "SOURCE_MD_DIR={source}/dist",
            "OBJDIR_NAME=OBJS"
          ],
          "cwd": "{build}"
        },
        {
          "args": [
            "env",
            "LD_LIBRARY_PATH={source}/dist/lib:{build_prefix}/lib",
            "{tools}/bin/python",
            "-c",
            "import ctypes; p=ctypes.CDLL('./libnss3.so'); p.NSS_GetVersion.restype=ctypes.c_char_p; v=p.NSS_GetVersion().decode(); print('Built NSS runtime:',v); assert v.startswith('3.133')"
          ],
          "cwd": "{source}/dist/lib"
        }
      ]
    }
  ]
}
