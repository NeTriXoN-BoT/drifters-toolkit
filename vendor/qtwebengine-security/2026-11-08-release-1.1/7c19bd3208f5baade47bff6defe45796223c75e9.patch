-std::pair<Node*, Node*>
-WasmGraphAssembler::LoadTrustedPointerFromObjectTrapOnNull(
-    Node* object, int field_offset, IndirectPointerTag tag) {
   Node* offset = IntPtrConstant(field_offset);
-#ifdef V8_ENABLE_SANDBOX
