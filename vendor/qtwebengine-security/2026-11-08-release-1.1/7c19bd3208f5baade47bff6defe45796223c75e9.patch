-  return {handle, BuildDecodeTrustedPointer(handle, tag)};
-#else
-  Node* value = LoadTrapOnNull(MachineType::TaggedPointer(), object, offset);
-  return {value, value};
+  return LoadFromObject(MachineType::TaggedPointer(), object, offset);
 #endif
 }
 
