From 0357716bcc3d3ca70ed1e2486800594233b2f004 Mon Sep 17 00:00:00 2001
From: Frank Liberato <liberato@chromium.org>
Date: Mon, 5 Oct 2026 22:01:09 +0000
Subject: [PATCH] [Backport] CVE-2026-121180: Buffer overflow in Media

Manual cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/chromium/third_party/ffmpeg/+/8517542:
avcodec/h264_slice: reset next_output_pic

Ensure next_output_pic is cleared when updating thread context and when
starting or selecting output for a field.

Bug: 567936265
Change-Id: I479b6161e286a2c110a18646db0a1691ca24d8f8
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/third_party/ffmpeg/+/8517542
Reviewed-by: Eugene Zemtsov <ezemtsov@google.com>
Reviewed-by: Eugene Zemtsov <eugene@chromium.org>
Reviewed-by: Syed AbuTalib <lowkey@google.com>
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/786791
Reviewed-by: Allan Sandfeld Jensen <allan.jensen@qt.io>
---
 chromium/third_party/ffmpeg/libavcodec/h264_slice.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/chromium/third_party/ffmpeg/libavcodec/h264_slice.c b/chromium/third_party/ffmpeg/libavcodec/h264_slice.c
index 7e53e38cca2f..b01a77d1e9e4 100644
--- a/chromium/third_party/ffmpeg/libavcodec/h264_slice.c
+++ b/chromium/third_party/ffmpeg/libavcodec/h264_slice.c
@@ -426,7 +426,7 @@ int ff_h264_update_thread_context(AVCodecContext *dst,
     memcpy(h->delayed_pic, h1->delayed_pic, sizeof(h->delayed_pic));
     memcpy(h->last_pocs,   h1->last_pocs,   sizeof(h->last_pocs));
 
-    h->next_output_pic   = h1->next_output_pic;
+    h->next_output_pic   = NULL;
     h->next_outputed_poc = h1->next_outputed_poc;
     h->poc_offset        = h1->poc_offset;
 
@@ -1383,6 +1383,7 @@ static int h264_select_output_frame(H264Context *h)
             }
         }
     } else {
+        h->next_output_pic = NULL;
         av_log(h->avctx, AV_LOG_DEBUG, "no picture %s\n", out_of_order ? "ooo" : "");
     }
 
@@ -1619,6 +1620,7 @@ static int h264_field_start(H264Context *h, const H264SliceContext *sl,
         int field = h->picture_structure == PICT_BOTTOM_FIELD;
         release_unused_pictures(h, 0);
         h->cur_pic_ptr->tf.owner[field] = h->avctx;
+        h->next_output_pic = NULL;
     }
     /* Some macroblocks can be accessed before they're available in case
     * of lost slices, MBAFF or threading. */
