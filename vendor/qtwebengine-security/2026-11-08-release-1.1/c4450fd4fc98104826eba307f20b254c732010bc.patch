From c4450fd4fc98104826eba307f20b254c732010bc Mon Sep 17 00:00:00 2001
From: Omer Katz <omerkatz@chromium.org>
Date: Fri, 23 Oct 2026 10:12:28 +0200
Subject: [PATCH] [Backport] CVE-2026-119263: Memory corruption in
 GarbageCollection

Manual cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/v8/v8/+/8614239:
Update the Steele-style barrier to always retrace

The barrier retraced objects only if they were already marked. This
doesn't work well with concurrent marking because the object could be
marked and the main thread hasn't observed it yet. Instead change the
barrier to mark regardless of whether the object was already marked.

Bug: 575143870
Change-Id: I5f027c5c5c28cc23fc25d562d266081afe216dc1
Reviewed-on: https://chromium-review.googlesource.com/c/v8/v8/+/8614239
Reviewed-by: Michael Lippautz <mlippautz@chromium.org>
Commit-Queue: Omer Katz <omerkatz@chromium.org>
Cr-Commit-Position: refs/heads/main@{#111098}
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/785286
Reviewed-by: Anu Aliyas <anu.aliyas@qt.io>
---
 chromium/v8/include/cppgc/heap-consistency.h |  4 +-
 chromium/v8/src/heap/cppgc/marker.h          | 43 ++++++++++----------
 2 files changed, 24 insertions(+), 23 deletions(-)

diff --git a/chromium/v8/include/cppgc/heap-consistency.h b/chromium/v8/include/cppgc/heap-consistency.h
index 23b5d909945b..31858f0a631b 100644
--- a/chromium/v8/include/cppgc/heap-consistency.h
+++ b/chromium/v8/include/cppgc/heap-consistency.h
@@ -146,8 +146,8 @@ class HeapConsistency final {
   }
 
   /**
-   * Steele-style write barrier that re-processes an object if it has already
-   * been processed.
+   * Steele-style write barrier that processes an object regardless of whether
+   * or not it has already been processed.
    *
    * \param params The parameters retrieved from `GetWriteBarrierType()`.
    * \param object The pointer to the object which must point to an object that
diff --git a/chromium/v8/src/heap/cppgc/marker.h b/chromium/v8/src/heap/cppgc/marker.h
index c245f1026d85..71358ee67153 100644
--- a/chromium/v8/src/heap/cppgc/marker.h
+++ b/chromium/v8/src/heap/cppgc/marker.h
@@ -10,6 +10,7 @@
 #include "include/cppgc/heap.h"
 #include "include/cppgc/platform.h"
 #include "include/cppgc/visitor.h"
+#include "src/base/logging.h"
 #include "src/base/macros.h"
 #include "src/base/platform/time.h"
 #include "src/heap/base/incremental-marking-schedule.h"
@@ -238,20 +239,15 @@ class V8_EXPORT_PRIVATE Marker final : public MarkerBase {
 
 template <MarkerBase::WriteBarrierType type>
 void MarkerBase::WriteBarrierForObject(HeapObjectHeader& header) {
-  // The barrier optimizes for the bailout cases:
-  // - kDijkstra: Marked objects.
-  // - kSteele: Unmarked objects.
-  switch (type) {
-    case MarkerBase::WriteBarrierType::kDijkstra:
-      if (!header.TryMarkAtomic()) {
-        return;
-      }
-      break;
-    case MarkerBase::WriteBarrierType::kSteele:
-      if (!header.IsMarked<AccessMode::kAtomic>()) {
-        return;
-      }
-      break;
+  // The Dijkstra barrier bails out on marked objects.
+  // The Steele barrier marks the object regardless of its current state.
+  // It's important to make sure the object is marked here since unmarking
+  // below for in construction objects expects a marked object.
+  const bool was_already_marked = !header.TryMarkAtomic();
+  if (type == MarkerBase::WriteBarrierType::kDijkstra) {
+    if (was_already_marked) {
+      return;
+    }
   }
 
   // The barrier fired. Filter out in-construction objects here. This possibly
@@ -267,13 +263,18 @@ void MarkerBase::WriteBarrierForObject(HeapObjectHeader& header) {
     return;
   }
 
-  switch (type) {
-    case MarkerBase::WriteBarrierType::kDijkstra:
-      mutator_marking_state_.write_barrier_worklist().Push(&header);
-      break;
-    case MarkerBase::WriteBarrierType::kSteele:
-      mutator_marking_state_.retrace_marked_objects_worklist().Push(&header);
-      break;
+  DCHECK_IMPLIES(was_already_marked,
+                 type == MarkerBase::WriteBarrierType::kSteele);
+  if ((type == MarkerBase::WriteBarrierType::kDijkstra) ||
+      !was_already_marked) {
+    // Push previously unmarked objects to the write barrier worklist, even for
+    // the Steele barrier, since popping from that worklist would also update
+    // the marked bytes counter.
+    mutator_marking_state_.write_barrier_worklist().Push(&header);
+  } else {
+    DCHECK((type == MarkerBase::WriteBarrierType::kSteele) &&
+           was_already_marked);
+    mutator_marking_state_.retrace_marked_objects_worklist().Push(&header);
   }
 }
 
