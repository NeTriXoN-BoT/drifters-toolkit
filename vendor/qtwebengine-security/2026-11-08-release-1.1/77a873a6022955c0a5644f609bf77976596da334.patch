From 77a873a6022955c0a5644f609bf77976596da334 Mon Sep 17 00:00:00 2001
From: Mason Freed <masonf@chromium.org>
Date: Fri, 23 Oct 2026 07:12:21 -0700
Subject: [PATCH] [Backport] CVE-2026-119267: Memory corruption in DOM

Cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/chromium/src/+/8633114:
Don't hold references to name or id across UpdateName()/UpdateId()

Element::InsertedInto() took a const AtomicString& reference into the
element's attribute storage via GetNameAttribute() and passed it to
UpdateName(). UpdateName() calls HTMLDocument::AddNamedItem(), which
initializes the frame's WindowProxy before calling NamedItemAdded().
Initializing a sandboxed frame's script context installs
chrome.loadTimes, which can invoke a page-defined setter on a child
frame named 'chrome'. If that setter mutates the element's attributes
and reallocates the attribute vector, the name_value reference dangles
when NamedItemAdded() reads it.

This CL copies the name and id attributes into local AtomicStrings by
value before calling UpdateName() and UpdateId() in InsertedInto(),
RemovedFrom(), and CloneAttributesFrom().

Fixed: 576203565
Change-Id: If2164a83f298dcfbea9b191776016eeadd8271a3
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8633114
Reviewed-by: David Baron <dbaron@chromium.org>
Commit-Queue: David Baron <dbaron@chromium.org>
Auto-Submit: Mason Freed <masonf@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1725772}
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/785290
Reviewed-by: Anu Aliyas <anu.aliyas@qt.io>
---
 .../blink/renderer/core/dom/element.cc        | 12 ++---
 .../nameditem-insertion-attr-mutation.html    | 49 +++++++++++++++++++
 2 files changed, 55 insertions(+), 6 deletions(-)
 create mode 100644 chromium/third_party/blink/web_tests/external/wpt/html/dom/documents/dom-tree-accessors/nameditem-insertion-attr-mutation.html

diff --git a/chromium/third_party/blink/renderer/core/dom/element.cc b/chromium/third_party/blink/renderer/core/dom/element.cc
index ecfe8bdd464..73bfb41205f 100644
--- a/chromium/third_party/blink/renderer/core/dom/element.cc
+++ b/chromium/third_party/blink/renderer/core/dom/element.cc
@@ -3829,7 +3829,7 @@ Node::InsertionNotificationRequest Element::InsertedInto(
     UpdateId(scope, g_null_atom, id_value);
   }
 
-  const AtomicString& name_value = GetNameAttribute();
+  AtomicString name_value = GetNameAttribute();
   if (!name_value.IsNull()) {
     UpdateName(g_null_atom, name_value);
   }
@@ -3965,7 +3965,7 @@ void Element::RemovedFrom(ContainerNode& insertion_point) {
       UpdateId(insertion_point.GetTreeScope(), id_value, g_null_atom);
     }
 
-    const AtomicString& name_value = GetNameAttribute();
+    AtomicString name_value = GetNameAttribute();
     if (!name_value.IsNull()) {
       UpdateName(name_value, g_null_atom);
     }
@@ -10680,15 +10680,15 @@ void Element::CloneAttributesFrom(const Element& other) {
     return;
   }
 
-  const AtomicString& old_id = GetIdAttribute();
-  const AtomicString& new_id = other.GetIdAttribute();
+  AtomicString old_id = GetIdAttribute();
+  AtomicString new_id = other.GetIdAttribute();
 
   if (!old_id.IsNull() || !new_id.IsNull()) {
     UpdateId(old_id, new_id);
   }
 
-  const AtomicString& old_name = GetNameAttribute();
-  const AtomicString& new_name = other.GetNameAttribute();
+  AtomicString old_name = GetNameAttribute();
+  AtomicString new_name = other.GetNameAttribute();
 
   if (!old_name.IsNull() || !new_name.IsNull()) {
     UpdateName(old_name, new_name);
diff --git a/chromium/third_party/blink/web_tests/external/wpt/html/dom/documents/dom-tree-accessors/nameditem-insertion-attr-mutation.html b/chromium/third_party/blink/web_tests/external/wpt/html/dom/documents/dom-tree-accessors/nameditem-insertion-attr-mutation.html
new file mode 100644
index 00000000000..92badc9f4e8
--- /dev/null
+++ b/chromium/third_party/blink/web_tests/external/wpt/html/dom/documents/dom-tree-accessors/nameditem-insertion-attr-mutation.html
@@ -0,0 +1,49 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<link rel="author" href="mailto:masonf@chromium.org">
+<link rel="help" href="https://crbug.com/576203565">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+
+<div id="container"></div>
+<script>
+test(() => {
+  const container = document.getElementById('container');
+
+  // Create a sandboxed iframe without allow-scripts so its script context
+  // is not initialized until AddNamedItem accesses its WindowProxy.
+  const sandbox = document.createElement('iframe');
+  sandbox.sandbox = 'allow-same-origin';
+  container.appendChild(sandbox);
+
+  const innerDoc = sandbox.contentDocument;
+  const img = innerDoc.createElement('img');
+  img.setAttribute('name', 'target_item');
+  for (let i = 0; i < 7; i++) {
+    img.setAttribute('data-a' + i, 'v');
+  }
+
+  // Create a child frame named "chrome" inside the sandboxed document.
+  // When AddNamedItem initializes the sandboxed frame's context and installs
+  // chrome.loadTimes, the setter on window.chrome.loadTimes will run and
+  // mutate img's attributes, reallocating its attribute buffer during UpdateName.
+  const child = innerDoc.createElement('iframe');
+  child.name = 'chrome';
+  innerDoc.body.appendChild(child);
+
+  Object.defineProperty(child.contentWindow, 'loadTimes', {
+    configurable: true,
+    set() {
+      for (let i = 7; i < 20; i++) {
+        img.setAttribute('data-a' + i, 'v');
+      }
+    }
+  });
+
+  innerDoc.body.appendChild(img);
+  assert_equals(innerDoc.target_item, img);
+
+  img.remove();
+  assert_equals(innerDoc.target_item, undefined);
+}, 'Mutating attributes during UpdateName in InsertedInto/RemovedFrom should not crash');
+</script>
