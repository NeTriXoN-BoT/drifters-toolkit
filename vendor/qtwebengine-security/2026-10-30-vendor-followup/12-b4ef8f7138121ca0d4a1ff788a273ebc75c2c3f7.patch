From b4ef8f7138121ca0d4a1ff788a273ebc75c2c3f7 Mon Sep 17 00:00:00 2001
From: Stephen Chenney <schenney@chromium.org>
Date: Tue, 20 Oct 2026 11:15:02 -0700
Subject: [PATCH] [Backport] CVE-2026-118353: Use after free in Paint

Cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/chromium/src/+/8613320:
Do not reuse non-CORS StyleImage data with a CORS request

The StyleImageCache does not record the CORS status of the cached
image content. Loading an image as a background with no CORS
requirement caches the image, and a subsequent request for the
same image as a CSS mask-image request for a CORS image will
return the non-CORS result from the cache.

Fix it by checking the origin status of the cached image and
rejecting it when its status is inadequate for the request.

Fixed: 572312175
Change-Id: Ia3e2bd9b9031118158941c23b799bdec96be17d8
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613320
Reviewed-by: Stefan Zager <szager@chromium.org>
Auto-Submit: Stephen Chenney <schenney@chromium.org>
Commit-Queue: Stefan Zager <szager@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1723067}
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/784939
Reviewed-by: Allan Sandfeld Jensen <allan.jensen@qt.io>
---
 .../blink/renderer/core/css/style_image_cache.cc         | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/chromium/third_party/blink/renderer/core/css/style_image_cache.cc b/chromium/third_party/blink/renderer/core/css/style_image_cache.cc
index 43ced3ebb68b..6e9e03560c19 100644
--- a/chromium/third_party/blink/renderer/core/css/style_image_cache.cc
+++ b/chromium/third_party/blink/renderer/core/css/style_image_cache.cc
@@ -12,10 +12,15 @@ namespace blink {
 
 namespace {
 
-bool CanReuseImageContent(const ImageResourceContent& image_content) {
+bool CanReuseImageContent(const ImageResourceContent& image_content,
+                          FetchParameters& params) {
   if (image_content.ErrorOccurred()) {
     return false;
   }
+  if (params.GetCrossOriginAttributeValue() != kCrossOriginAttributeNotSet &&
+      !image_content.IsCorsSameOrigin()) {
+    return false;
+  }
   return true;
 }
 
@@ -31,7 +36,7 @@ ImageResourceContent* StyleImageCache::CacheImageContent(
   auto& image_content =
       fetched_image_map_.insert(url_without_fragment.GetString(), nullptr)
           .stored_value->value;
-  if (!image_content || !CanReuseImageContent(*image_content)) {
+  if (!image_content || !CanReuseImageContent(*image_content, params)) {
     image_content = ImageResourceContent::Fetch(params, fetcher);
   }
   return image_content.Get();
