From bb31ed6efa16c2f853117dac90be518142e2f73f Mon Sep 17 00:00:00 2001
From: Le Hoang Quyen <lehoangquyen@chromium.org>
Date: Fri, 9 Oct 2026 02:33:55 +0800
Subject: [PATCH] [Backport] CVE-2026-118329: Improper input validation in
 ANGLE

Manual cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/angle/angle/+/8542591:
Metal: Fix 2D array layer count check in TextureMtl::redefineImage

For MTLTextureType2DArray textures, MTLTexture.depth is always 1 while
the layer count is stored in arrayLength. Substitute arrayLength into
the depth component via GetTextureGLSize when comparing GL image
extents in TextureMtl::redefineImage so layer-count-only redefinitions
properly release stale storage and per-level views.

Bug: chromium:568900535
Change-Id: I9d0b6a36941d739fab15ab1fa37767946bc0441b
Reviewed-on: https://chromium-review.googlesource.com/c/angle/angle/+/8542591
Reviewed-by: Kenneth Russell <kbr@chromium.org>
Commit-Queue: Quyen Le <lehoangquyen@google.com>
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/784359
Reviewed-by: Moss Heim <moss.heim@qt.io>
---
 .../src/libANGLE/renderer/metal/TextureMtl.mm | 21 +++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/chromium/third_party/angle/src/libANGLE/renderer/metal/TextureMtl.mm b/chromium/third_party/angle/src/libANGLE/renderer/metal/TextureMtl.mm
index 712f3d7e74d..8bf4728f3bf 100644
--- a/chromium/third_party/angle/src/libANGLE/renderer/metal/TextureMtl.mm
+++ b/chromium/third_party/angle/src/libANGLE/renderer/metal/TextureMtl.mm
@@ -757,6 +757,19 @@ GLenum OverrideSwizzleValue(const gl::Context *context,
     return levelTextureViews[level];
 }
 
+// Returns the texture extents in GL terms, substituting arrayLength into depth for array textures
+// since MTLTexture stores layer count in arrayLength with depth == 1.
+gl::Extents GetTextureGLSize(const mtl::TextureRef &texture,
+                             const mtl::MipmapNativeLevel &nativeLevel)
+{
+    gl::Extents size = texture->size(nativeLevel);
+    if (texture->textureType() == MTLTextureType2DArray)
+    {
+        size.depth = static_cast<int>(texture->arrayLength());
+    }
+    return size;
+}
+
 }  // namespace
 
 // TextureMtl::NativeTextureWrapper implementation.
@@ -843,6 +856,10 @@ uint32_t height(GLuint glLevel) const
     uint32_t depth(GLuint glLevel) const { return mNativeTexture->depth(getNativeLevel(glLevel)); }
 
     gl::Extents size(GLuint glLevel) const { return mNativeTexture->size(getNativeLevel(glLevel)); }
+    gl::Extents getGLSize(GLuint glLevel) const
+    {
+        return GetTextureGLSize(mNativeTexture, getNativeLevel(glLevel));
+    }
 
     // Get width, height, depth, size at base level.
     uint32_t widthAt0() const { return width(mBaseGLLevel); }
@@ -2088,7 +2105,7 @@ uint32_t height(GLuint glLevel) const
         // must release it.
         ASSERT(mNativeTextureStorage->textureType() == mtl::GetTextureType(index.getType()));
         if (mNativeTextureStorage->getFormat() != mtlFormat ||
-            size != mNativeTextureStorage->size(glLevel))
+            size != mNativeTextureStorage->getGLSize(glLevel))
         {
             // Keep other images
             deallocateNativeStorage(/*keepImages=*/true);
@@ -2112,7 +2129,7 @@ uint32_t height(GLuint glLevel) const
             imageDef.image->textureType() ==
                 mtl::GetTextureType(GetTextureImageType(index.getType())) &&
             imageDef.formatID == mNativeTextureStorage->getFormat().intendedFormatId &&
-            imageDef.image->sizeAt0() == size)
+            GetTextureGLSize(imageDef.image, mtl::kZeroNativeMipLevel) == size)
         {
             // Keep it! (No-op)
         }
