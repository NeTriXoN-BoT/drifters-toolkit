From 23a6bb84a24720a0064e1a0da9e1c7c71f56f72e Mon Sep 17 00:00:00 2001
From: Shunya Shishido <sisidovski@chromium.org>
Date: Mon, 28 Sep 2026 23:02:42 -0700
Subject: [PATCH] [Backport] CVE-2026-113318: Memory corruption in
 ServiceWorker

Manual cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/chromium/src/+/8474871:
[ServiceWorker] Defer clone completion callback in SimpleBufferManager

Post clone_complete_callback_ via
SequencedTaskRunner::GetCurrentDefault()->PostTask() in
RaceNetworkRequestSimpleBufferManager::Finish() instead of running it
synchronously.

Bug: 566136673
Change-Id: I8f5cb74a4a882334b3d7cb5d1b81987fefdc5ca4
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8474871
Commit-Queue: Shunya Shishido <sisidovski@chromium.org>
Reviewed-by: Yoshisato Yanagisawa <yyanagisawa@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1706765}
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/783838
Reviewed-by: Moss Heim <moss.heim@qt.io>
---
 .../race_network_request_simple_buffer_manager.cc            | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/chromium/content/common/service_worker/race_network_request_simple_buffer_manager.cc b/chromium/content/common/service_worker/race_network_request_simple_buffer_manager.cc
index f3b670c42065..c57f15e6382c 100644
--- a/chromium/content/common/service_worker/race_network_request_simple_buffer_manager.cc
+++ b/chromium/content/common/service_worker/race_network_request_simple_buffer_manager.cc
@@ -62,7 +62,10 @@ void RaceNetworkRequestSimpleBufferManager::Finish() {
   write_position_ = 0;
   producer_handle_.reset();
   producer_handle_watcher_.reset();
-  std::move(clone_complete_callback_).Run();
+  if (clone_complete_callback_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(clone_complete_callback_));
+  }
 }
 
 void RaceNetworkRequestSimpleBufferManager::MaybeWriteData() {
