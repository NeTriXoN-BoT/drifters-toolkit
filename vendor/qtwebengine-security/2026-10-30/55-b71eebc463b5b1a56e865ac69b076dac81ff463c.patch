From b71eebc463b5b1a56e865ac69b076dac81ff463c Mon Sep 17 00:00:00 2001
From: Danil Chapovalov <danilchap@webrtc.org>
Date: Fri, 16 Oct 2026 16:35:33 +0200
Subject: [PATCH] [Backport] CVE-2026-118328: Improper input validation in
 WebRTC

Manual cherry-pick of patch originally reviewed on
https://webrtc-review.googlesource.com/c/src/+/509462:
Fail EncodeFec when packets are passed radically out of order

Bug: chromium:570927027
Change-Id: I9fd8d548e9e7935a4862dc95cb65548eba3b4c5f
Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/509462
Reviewed-by: Rasmus Brandt <brandtr@webrtc.org>
Commit-Queue: Danil Chapovalov <danilchap@webrtc.org>
Cr-Commit-Position: refs/heads/main@{#48960}
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/784358
Reviewed-by: Moss Heim <moss.heim@qt.io>
---
 .../third_party/webrtc/modules/rtp_rtcp/BUILD.gn  |  1 +
 .../rtp_rtcp/source/forward_error_correction.cc   | 15 +++++++++++----
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/chromium/third_party/webrtc/modules/rtp_rtcp/BUILD.gn b/chromium/third_party/webrtc/modules/rtp_rtcp/BUILD.gn
index e891203d4096..6042f801b3ec 100644
--- a/chromium/third_party/webrtc/modules/rtp_rtcp/BUILD.gn
+++ b/chromium/third_party/webrtc/modules/rtp_rtcp/BUILD.gn
@@ -569,6 +569,7 @@ if (rtc_include_tests) {
       ":rtp_rtcp",
       ":rtp_rtcp_format",
       "..:module_fec_api",
+      "../../rtc_base:byte_order",
       "../../rtc_base:checks",
       "../../rtc_base:random",
       "../../test:fileutils",
diff --git a/chromium/third_party/webrtc/modules/rtp_rtcp/source/forward_error_correction.cc b/chromium/third_party/webrtc/modules/rtp_rtcp/source/forward_error_correction.cc
index 0bb81a8ef0bf..c3e4e22e13b0 100644
--- a/chromium/third_party/webrtc/modules/rtp_rtcp/source/forward_error_correction.cc
+++ b/chromium/third_party/webrtc/modules/rtp_rtcp/source/forward_error_correction.cc
@@ -294,9 +294,13 @@ int ForwardErrorCorrection::InsertZerosInPacketMasks(
   size_t old_bit_index = 1;
   // Insert zeros in the bit mask for every hole in the sequence.
   while (media_packets_it != media_packets.end()) {
-    if (new_bit_index == max_media_packets) {
-      // We can only cover up to 48 packets.
-      break;
+    if (new_bit_index >= max_media_packets) {
+      // `total_missing_seq_nums` calculation above should ensure all
+      // `media_packets` fit within the `max_media_packets`. That calculation is
+      // simple and fast normally, but wrong when sequence numbers wrap around
+      // a lot. This condition catches exactly that - when number of packets
+      // to protect turned to be larger than earlier estimated.
+      return -1;
     }
     uint16_t seq_num = ParseSequenceNumber((*media_packets_it)->data.data());
     const int num_zeros_to_insert =
@@ -305,8 +309,11 @@ int ForwardErrorCorrection::InsertZerosInPacketMasks(
       internal::InsertZeroColumns(num_zeros_to_insert, tmp_packet_masks_,
                                   tmp_packet_mask_size, num_fec_packets,
                                   new_bit_index);
+      new_bit_index += num_zeros_to_insert;
+      if (new_bit_index >= max_media_packets) {
+        return -1;
+      }
     }
-    new_bit_index += num_zeros_to_insert;
     internal::CopyColumn(tmp_packet_masks_, tmp_packet_mask_size, packet_masks_,
                          packet_mask_size_, num_fec_packets, new_bit_index,
                          old_bit_index);
