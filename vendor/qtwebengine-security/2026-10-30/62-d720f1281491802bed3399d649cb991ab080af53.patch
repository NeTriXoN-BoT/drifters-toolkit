From d720f1281491802bed3399d649cb991ab080af53 Mon Sep 17 00:00:00 2001
From: kylechar <kylechar@chromium.org>
Date: Wed, 21 Oct 2026 07:43:36 -0700
Subject: [Backport] CVE-2026-118346: Use after free in Compositing

Cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/chromium/src/+/8613476:
Fix CopyOutputRequest check with OffsetTags

ResolvedFrameData makes a copy of all CompositorRenderPasses to modify
when there is an OffsetTag involved. CopyOutputRequests were not moved
to the copy but SurfaceAggregator checked the copy instead of original.
This resulted in not correctly marking the render pass as containing a
copy output request and not expanding damage. The CopyOutputRequest was
still moved from original CompositorRenderPass to AggregatedRenderPass
correctly.

Bug: 574382050
Change-Id: I872479f72f05ee5d8b05a8ee7b5b1c4241cb6c28
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613476
Reviewed-by: Jonathan Ross <jonross@chromium.org>
Commit-Queue: Kyle Charbonneau <kylechar@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1723797}
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/784481
Reviewed-by: Michal Klocek <michal.klocek@qt.io>
---
 .../components/viz/service/display/resolved_frame_data.cc     | 11 +++++++++--
 chromium/components/viz/service/display/resolved_frame_data.h |  9 +++++++++
 chromium/components/viz/service/display/surface_aggregator.cc |  4 +---
 3 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/chromium/components/viz/service/display/resolved_frame_data.cc b/chromium/components/viz/service/display/resolved_frame_data.cc
index d9e204f3556..e4cf2488fb2 100644
--- a/chromium/components/viz/service/display/resolved_frame_data.cc
+++ b/chromium/components/viz/service/display/resolved_frame_data.cc
@@ -91,6 +91,10 @@ const CompositorRenderPass& ResolvedPassData::render_pass() const {
   return *fixed_.render_pass;
 }
 
+bool ResolvedPassData::HasCopyOutputRequests() const {
+  return !fixed_.original_render_pass->copy_requests.empty();
+}
+
 void ResolvedPassData::CopyAndResetPersistentPassData() {
   previous_persistent_data_ = current_persistent_data_;
   current_persistent_data_ = PersistentPassData();
@@ -100,10 +104,12 @@ void ResolvedPassData::SetCompositorRenderPass(CompositorRenderPass* pass) {
   CHECK(pass);
   CHECK_EQ(pass->id, fixed_.render_pass_id);
   fixed_.render_pass = pass;
+  fixed_.original_render_pass = pass;
 }
 
 void ResolvedPassData::ResetCompositorRenderPass() {
   fixed_.render_pass = nullptr;
+  fixed_.original_render_pass = nullptr;
 }
 
 ResolvedFrameData::ResolvedFrameData(DisplayResourceProvider* resource_provider,
@@ -211,6 +217,7 @@ void ResolvedFrameData::UpdateActiveFrame(
     FixedPassData fixed;
 
     fixed.render_pass = render_pass.get();
+    fixed.original_render_pass = render_pass.get();
 
     AggregatedRenderPassId& remapped_id = aggregated_id_map_[render_pass->id];
     if (remapped_id.is_null()) {
@@ -345,8 +352,8 @@ void ResolvedFrameData::UpdateOffsetTags(OffsetTagLookupFn lookup_value_fn) {
     // cleared elsewhere they can be reused.
     CHECK_EQ(offset_tag_render_passes_.size(), resolved_passes_.size());
     for (size_t i = 0; i < offset_tag_render_passes_.size(); ++i) {
-      resolved_passes_[i].SetCompositorRenderPass(
-          offset_tag_render_passes_[i].get());
+      resolved_passes_[i].fixed_.render_pass =
+          offset_tag_render_passes_[i].get();
     }
     // Skip running RecomputeOffsetTagDamage() since nothing changed since
     // last frame and there is no added damage.
diff --git a/chromium/components/viz/service/display/resolved_frame_data.h b/chromium/components/viz/service/display/resolved_frame_data.h
index 02f50f29b09..f097220d790 100644
--- a/chromium/components/viz/service/display/resolved_frame_data.h
+++ b/chromium/components/viz/service/display/resolved_frame_data.h
@@ -55,6 +55,10 @@ struct VIZ_SERVICE_EXPORT FixedPassData {
   // destroyed during aggregation so the pointer will remain valid for the
   // duration of aggregation (until it's set to null).
   raw_ptr<CompositorRenderPass> render_pass = nullptr;
+  // Points to the original CompositorRenderPass held by the surface, which may
+  // differ from `render_pass` when `RebuildRenderPassesForOffsetTags()` makes a
+  // modified copy.
+  raw_ptr<const CompositorRenderPass> original_render_pass = nullptr;
 
   // How many times this render pass is embedded by another render pass in the
   // same frame.
@@ -175,6 +179,11 @@ class VIZ_SERVICE_EXPORT ResolvedPassData {
     return !fixed_.is_root && fixed_.embed_count == 0;
   }
 
+  // Returns true if the original CompositorRenderPass in `Surface` has any
+  // CopyOutputRequests. Note that `render_pass().copy_requests` may be empty if
+  // `render_pass()` points to an OffsetTag-modified copy.
+  bool HasCopyOutputRequests() const;
+
   AggregationPassData& aggregation() { return aggregation_; }
   const AggregationPassData& aggregation() const { return aggregation_; }
 
diff --git a/chromium/components/viz/service/display/surface_aggregator.cc b/chromium/components/viz/service/display/surface_aggregator.cc
index f1bf28ea57a..363addbbb1b 100644
--- a/chromium/components/viz/service/display/surface_aggregator.cc
+++ b/chromium/components/viz/service/display/surface_aggregator.cc
@@ -2079,11 +2079,9 @@ gfx::Rect SurfaceAggregator::PrewalkSurface(ResolvedFrameData& resolved_frame,
   }
 
   for (auto& resolved_pass : resolved_frame.GetResolvedPasses()) {
-    auto& render_pass = resolved_pass.render_pass();
-
     // Checking for copy requests need to be done after the prewalk because
     // copy requests can get added after damage is computed.
-    if (!render_pass.copy_requests.empty()) {
+    if (resolved_pass.HasCopyOutputRequests()) {
       has_copy_requests_ = true;
       MarkAndPropagateCopyRequestPasses(resolved_pass);
     }
