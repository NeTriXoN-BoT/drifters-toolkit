From 5ea6b0039609fe37bd28a62b679bfe8ecbaa3ce7 Mon Sep 17 00:00:00 2001
From: Kenichi Ishibashi <bashi@chromium.org>
Date: Tue, 20 Oct 2026 05:24:29 -0700
Subject: [PATCH] [Backport] CVE-2026-118341: Use after free in Modularization

Cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/chromium/src/+/8619132:
Ensure OomInterventionImpl is alive during Check()

OomInterventionImpl::Check() iterates over local frames and invokes
NavigateLocalAdsFrames() and LocalFrame::ForciblyPurgeV8Memory(), which
may synchronously run script and disconnect the OomIntervention receiver
before the loop finishes.

Guard `this` with a WeakPtr in Check() and return early if the instance
is destroyed during frame iteration. Also remove `this` from
MemoryUsageMonitor before iterating over frames.

Bug: 574911701
Change-Id: I5c5761e0b7b6bc3f06c69c376563e36295848455
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8619132
Commit-Queue: Kenichi Ishibashi <bashi@chromium.org>
Reviewed-by: Kentaro Hara <haraken@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1722812}
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/784478
Reviewed-by: Michal Klocek <michal.klocek@qt.io>
---
 .../renderer/controller/oom_intervention_impl.cc  | 15 ++++++++++++---
 .../renderer/controller/oom_intervention_impl.h   |  2 ++
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/chromium/third_party/blink/renderer/controller/oom_intervention_impl.cc b/chromium/third_party/blink/renderer/controller/oom_intervention_impl.cc
index 168deaf68243..36d3cd75ad38 100644
--- a/chromium/third_party/blink/renderer/controller/oom_intervention_impl.cc
+++ b/chromium/third_party/blink/renderer/controller/oom_intervention_impl.cc
@@ -121,7 +121,9 @@ void OomInterventionImpl::Check(MemoryUsage usage) {
 
   if (oom_detected) {
     base::debug::SetCrashKeyString(GetStateCrashKey(), "during");
+    MemoryUsageMonitorInstance().RemoveObserver(this);
 
+    auto weak_this = weak_factory_.GetWeakPtr();
     if (navigate_ads_enabled_ || purge_v8_memory_enabled_) {
       // Copy Page::OrdinaryPages() to avoid UAF. Synchronous JS
       // execution during iteration can create new pages, which causes rehashing
@@ -134,10 +136,18 @@ void OomInterventionImpl::Check(MemoryUsage usage) {
           auto* local_frame = DynamicTo<LocalFrame>(frame);
           if (!local_frame)
             continue;
-          if (navigate_ads_enabled_)
+          if (navigate_ads_enabled_) {
             NavigateLocalAdsFrames(local_frame);
-          if (purge_v8_memory_enabled_)
+            if (!weak_this) {
+              return;
+            }
+          }
+          if (purge_v8_memory_enabled_) {
             local_frame->ForciblyPurgeV8Memory();
+            if (!weak_this) {
+              return;
+            }
+          }
         }
       }
     }
@@ -149,7 +159,6 @@ void OomInterventionImpl::Check(MemoryUsage usage) {
     }
 
     host_->OnHighMemoryUsage();
-    MemoryUsageMonitorInstance().RemoveObserver(this);
     // Send memory pressure notification to trigger GC.
     task_runner_->PostTask(FROM_HERE, WTF::BindOnce(&TriggerGC));
     // Notify V8GCForContextDispose that page navigation gc is needed when
diff --git a/chromium/third_party/blink/renderer/controller/oom_intervention_impl.h b/chromium/third_party/blink/renderer/controller/oom_intervention_impl.h
index d9d3e711cba3..f6291795e77b 100644
--- a/chromium/third_party/blink/renderer/controller/oom_intervention_impl.h
+++ b/chromium/third_party/blink/renderer/controller/oom_intervention_impl.h
@@ -8,6 +8,7 @@
 #include <memory>
 
 #include "base/gtest_prod_util.h"
+#include "base/memory/weak_ptr.h"
 #include "base/task/single_thread_task_runner.h"
 #include "base/types/pass_key.h"
 #include "mojo/public/cpp/bindings/pending_receiver.h"
@@ -85,6 +86,7 @@ class CONTROLLER_EXPORT OomInterventionImpl
   bool navigate_ads_enabled_ = false;
   bool purge_v8_memory_enabled_ = false;
   std::unique_ptr<ScopedPagePauser> pauser_;
+  base::WeakPtrFactory<OomInterventionImpl> weak_factory_{this};
 };
 
 }  // namespace blink
