+bool AXNodeData::HasValidAXNodeIDsFromRenderer() const {
+  if (!IsValidAXNodeIDFromRenderer(id)) {
+    return false;
+  }
+  for (AXNodeID child_id : child_ids) {
+    if (!IsValidAXNodeIDFromRenderer(child_id)) {
+      return false;
+    }
+  }
+  return true;
+}
