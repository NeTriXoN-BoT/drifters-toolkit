From 3234d6d7ecadbcdc9b30aca9de07f27facaa1a94 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Fredrik=20S=C3=B6derquist?= <fs@opera.com>
Date: Mon, 19 Oct 2026 13:53:59 -0700
Subject: [PATCH] [Backport] CVE-2026-118308: Use after free in SVG
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/chromium/src/+/8610829:
Make timed elements inserted into <use> shadow trees inert

If timed elements somehow make it into a <use> shadow tree, they should
not be scheduled on the timeline. Treat them the same as if they were
not in the document at all.

Fixed: 574791952
Change-Id: I0a88c3a352139fbe2b93f4634794de929826ff47
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8610829
Reviewed-by: Stephen Chenney <schenney@chromium.org>
Commit-Queue: Stephen Chenney <schenney@chromium.org>
Auto-Submit: Fredrik Söderquist <fs@opera.com>
Cr-Commit-Position: refs/heads/main@{#1722305}
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/784355
Reviewed-by: Moss Heim <moss.heim@qt.io>
---
 .../blink/renderer/core/svg/animation/svg_smil_element.cc     | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/chromium/third_party/blink/renderer/core/svg/animation/svg_smil_element.cc b/chromium/third_party/blink/renderer/core/svg/animation/svg_smil_element.cc
index f55d26dc2b97..19a44c99fa28 100644
--- a/chromium/third_party/blink/renderer/core/svg/animation/svg_smil_element.cc
+++ b/chromium/third_party/blink/renderer/core/svg/animation/svg_smil_element.cc
@@ -268,7 +268,9 @@ void SVGSMILElement::BuildPendingResource() {
   ClearResourceAndEventBaseReferences();
   DisconnectConditions();
 
-  if (!isConnected()) {
+  // Ignore timed elements that are inserted into a <use> shadow tree. This is
+  // currently possible via a cloned event handler.
+  if (!isConnected() || InUseShadowTree()) {
     // Reset the target element if we are no longer in the document.
     SetTargetElement(nullptr);
     return;
