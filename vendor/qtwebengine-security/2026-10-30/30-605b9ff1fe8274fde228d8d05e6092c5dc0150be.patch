+set -e -u -o pipefail
+
+cd "$(dirname "$(type -P "$0")")"
+
+PS4=$'\n+ '
+
+tidy_args=(
+    --indent 1
+    --tidy-mark no
+    --vertical-space yes
+    --wrap 90
+    --write-back yes
+)
+
+set -x
+
+# Re-indent XHTML
+tidy "${tidy_args[@]}" doc/reference.html
+
+# Drop trailing whitespace
+sed 's, \+$,,' -i.bak doc/reference.html
