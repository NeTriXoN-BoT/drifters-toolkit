+name: Compile and test with Clang-based MinGW
+
+on:
+  pull_request:
+  push:
+  schedule:
+    - cron: '0 2 * * 5'  # Every Friday at 2am
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  mingw_clang:
+    name: Compile and test with Clang-based MinGW (${{ matrix.mingw_arch }}, ${{ matrix.name }})
+    timeout-minutes: 15
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - name: char
+            cmake_args: -DEXPAT_CHAR_TYPE=char
+            mingw_arch: i686
+            wine_arch: win32
+            wine_packages: wine32:i386 wine32-preloader:i386
+          - name: wchar_t
+            cmake_args: -DEXPAT_CHAR_TYPE=wchar_t
+            mingw_arch: x86_64
+            wine_arch: win64
+            wine_package: wine64 wine64-preloader
+    runs-on: ubuntu-26.04
+    container:
+      # We use Debian trixie here because combination "Clang MinGW ASan Wine"
+      # is broken on Ubuntu.
+      image: debian:trixie-slim
+      env:
+        # Job containers run as root, but the workspace bind mount is runner-owned.
+        # Wine rejects a prefix below a directory owned by another user.
+        WINEPREFIX: /tmp/libexpat-wineprefix
+        # This avoids
+        #   error: XDG_RUNTIME_DIR is invalid or not set in the environment.
+        # from Wine from inside the container.
+        XDG_RUNTIME_DIR: /run/user/0
+      # This unblocks 32bit wineserver; without it, we would get this error:
+      #   sock_init: ERROR in sock_check_pollhup()
+      #   wineserver: socket: Function not implemented
+      options: >-
+        --security-opt apparmor=unconfined
+        --security-opt  seccomp=unconfined
+    defaults:
+      run:
+        shell: "bash -e {0}"  # because the default is only POSIX shell
+
+    steps:
+    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
+      with:
+        persist-credentials: false
+
+    - name: Install build dependencies (everything but MinGW)
+      env:
+        DEBIAN_FRONTEND: noninteractive
+        wine_packages: ${{ matrix.wine_packages }}
+      run: |-
+        set -x
+        if [[ ${wine_packages} =~ :i386 ]]; then
+            dpkg --add-architecture i386
+        fi
+        apt-get update
+        timeout 10m apt-get install --yes --no-install-recommends -V \
+            ca-certificates \
+            cmake \
+            make \
+            python3 \
+            retry \
+            unzip \
+            wget \
+            wine \
+            ${wine_packages} \
+            xz-utils
+
+    - name: Install build dependencies (Clang-based MinGW toolchain)
+      run: |-
+        version=20260908  # with LLVM/Clang 23.1.1
+        sha256sum=2258c745e3155870c80793f3e8c80b28fbde11b9ff73c4c78783635b3440b092
+
+        dirname="llvm-mingw-${version}-ucrt-ubuntu-22.04-x86_64"
+        tarball="${dirname}.tar.xz"
+        set -x
+        wget \
+            --progress=dot:giga \
+            "https://github.com/mstorsjo/llvm-mingw/releases/download/${version}/${tarball}"
+        sha256sum --check <<<"${sha256sum}  ${tarball}"
+        tar xf "${tarball}"
+        echo "${PWD}/${dirname}/bin" >>"${GITHUB_PATH}"
+
+    - name: Configure
+      env:
+        cmake_args: ${{ matrix.cmake_args }}
+        wine_arch: ${{ matrix.wine_arch }}
+      run: |-
+        set -u
+        args=(
+            -DCMAKE_TOOLCHAIN_FILE=cmake/mingw-toolchain-${wine_arch}.cmake
+
+            -DCMAKE_{C,CXX}_FLAGS='-Wall -Wextra -pedantic -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer'
+            -DCMAKE_{EXE,MODULE,SHARED}_LINKER_FLAGS='-g -fsanitize=address,undefined'
+
+            -DEXPAT_BUILD_DOCS=OFF
+            -DEXPAT_BUILD_TESTS=ON
+            -DEXPAT_WARNINGS_AS_ERRORS=ON
+
+            ${cmake_args}
+        )
+        set -x
+        cmake "${args[@]}" -S expat/ -B build/
+
+    - name: Build
+      run: |-
+        set -x
+        make -C build -j$(nproc) VERBOSE=1
+
+    - name: Run unit tests (takes about 3 minutes)
+      env:
+        retry: retry --times 5 --  # mitigate Wine crashing randomly in CI
+        mingw_arch: ${{ matrix.mingw_arch }}
+        WINEDEBUG: -all            # to reduce noise
+      run: |-
+        set -x
+
+        # Make Wine find the needed DLL files:
+        # - libc++.dll
+        # - libclang_rt.asan_dynamic-*.dll
+        # - libexpat*.dll
+        # - libunwind.dll
+        export WINEPATH="$(winepath -w build);$(winepath -w llvm-mingw-*-ucrt-ubuntu-*/${mingw_arch}-w64-mingw32/bin)"
+
+        make -C build CTEST_OUTPUT_ON_FAILURE=1 test
+
+        # Bypass `run-xmltest` on 64bit because it takes forever,
+        # needs more debugging
+        if [[ ${mingw_arch} != x86_64 ]]; then
+            ${retry} make -C build run-xmltest
+        fi
