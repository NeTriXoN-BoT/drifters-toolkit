+name: Build and test with Fil-C
+
+on:
+  pull_request:
+  push:
+  schedule:
+    - cron: '0 2 * * 5'  # Every Friday at 2am
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  fil_c:
+    name: Build and test with Fil-C
+    timeout-minutes: 15
+    runs-on: ubuntu-24.04
+    steps:
+    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
+      with:
+        persist-credentials: false
+
+    - name: Install Fil-C toolchain
+      run: |-
+        version=0.685  # of 2026-09-16
+        sha256sum=d12bd30c33f18179a9355b32ea44ba61dcc0342c7d77d1ac2548852e64994727
+
+        dirname="filc-${version}-linux-$(uname -m)"
+        tarball="${dirname}.tar.xz"
+        set -x
+        wget --progress=dot:giga "https://github.com/pizlonator/fil-c/releases/download/v${version}/${tarball}"
+        sha256sum --check <<<"${sha256sum} ${dirname}.tar.xz"
+        tar xf "${tarball}"
+        ( cd "${dirname}" && ./setup.sh )
+        echo "${PWD}/${dirname}/build/bin" >>"${GITHUB_PATH}"
+
+    - name: Build using Fil-C
+      run: |
+        cmake_args=(
+          -DCMAKE_C_COMPILER=filcc
+          -DCMAKE_CXX_COMPILER=filc++
+          -DCMAKE_{C,CXX}_FLAGS='-march=native -O2 -pipe -Wall -Wextra -pedantic -Wno-overlength-strings'
+          -DEXPAT_BUILD_DOCS=OFF
+          -DEXPAT_WARNINGS_AS_ERRORS=ON
+        )
+        set -x
+        cmake "${cmake_args[@]}" -S expat/ -B build/
+        make -C build -j$(nproc) VERBOSE=1 all
+
+    - name: Run the test suite
+      run: |
+        make -C build/ test run-xmltest
