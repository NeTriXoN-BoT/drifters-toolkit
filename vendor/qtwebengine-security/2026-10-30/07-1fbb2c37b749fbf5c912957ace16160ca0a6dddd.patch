From 1fbb2c37b749fbf5c912957ace16160ca0a6dddd Mon Sep 17 00:00:00 2001
From: Tom Sepez <tsepez@google.com>
Date: Tue, 13 Oct 2026 18:43:02 -0700
Subject: [PATCH] [Backport] CVE-2026-113212: Memory corruption in PDF (1/2)

Manual cherry-pick of patch originally reviewed on
https://pdfium-review.googlesource.com/c/pdfium/+/160614:
Guard against re-entrant destruction of the CJS_Runtime

Prevent a (somewhat) misbehaving embedder from tearing down the
runtime while a callback is still in-flight.

Bug: 572237007
Change-Id: I003a6b67703305c465a2ed0845f4274df93ed5af
Reviewed-on: https://pdfium-review.googlesource.com/c/pdfium/+/160614
Commit-Queue: Lei Zhang <thestig@chromium.org>
Reviewed-by: Lei Zhang <thestig@chromium.org>
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/783582
Reviewed-by: Moss Heim <moss.heim@qt.io>
---
 chromium/third_party/pdfium/fxjs/cjs_app.cpp     | 6 ++++++
 chromium/third_party/pdfium/fxjs/cjs_runtime.cpp | 1 +
 2 files changed, 7 insertions(+)

diff --git a/chromium/third_party/pdfium/fxjs/cjs_app.cpp b/chromium/third_party/pdfium/fxjs/cjs_app.cpp
index e38e465da6a5..da0676bfc975 100644
--- a/chromium/third_party/pdfium/fxjs/cjs_app.cpp
+++ b/chromium/third_party/pdfium/fxjs/cjs_app.cpp
@@ -288,7 +288,10 @@ CJS_Result CJS_App::beep(CJS_Runtime* pRuntime,
     type = pRuntime->ToInt32(params[0]);
   }
 
+  pRuntime->BeginBlock();
   pRuntime->GetFormFillEnv()->JS_appBeep(type);
+  pRuntime->EndBlock();
+
   return CJS_Result::Success();
 }
 
@@ -585,8 +588,11 @@ CJS_Result CJS_App::response(CJS_Runtime* pRuntime,
   static constexpr int kMaxWideChars = 1024;
   static constexpr int kMaxBytes = kMaxWideChars * sizeof(uint16_t);
   auto buffer = FixedSizeDataVector<uint8_t>::Zeroed(kMaxBytes);
+
+  pRuntime->BeginBlock();
   int byte_length = pRuntime->GetFormFillEnv()->JS_appResponse(
       swQuestion, swTitle, swDefault, swLabel, bPassword, buffer.span());
+  pRuntime->EndBlock();
 
   if (byte_length < 0 || byte_length > kMaxBytes) {
     return CJS_Result::Failure(JSMessage::kParamTooLongError);
diff --git a/chromium/third_party/pdfium/fxjs/cjs_runtime.cpp b/chromium/third_party/pdfium/fxjs/cjs_runtime.cpp
index aaac4df768c1..7c9ab11a3c74 100644
--- a/chromium/third_party/pdfium/fxjs/cjs_runtime.cpp
+++ b/chromium/third_party/pdfium/fxjs/cjs_runtime.cpp
@@ -74,6 +74,7 @@ CJS_Runtime::CJS_Runtime(CPDFSDK_FormFillEnvironment* pFormFillEnv)
 }
 
 CJS_Runtime::~CJS_Runtime() {
+  CHECK(!IsBlocking());
   NotifyObservers();
   ReleaseEngine();
   if (isolate_managed_) {
