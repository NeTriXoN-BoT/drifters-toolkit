--- /dev/null
+++ b/third_party/expat/src/.github/workflows/scripts/check_for_missing_config_header_includes.sh
@@ -0,0 +1,64 @@
+#! /usr/bin/env bash
+#                          __  __            _
+#                       ___\ \/ /_ __   __ _| |_
+#                      / _ \\  /| '_ \ / _` | __|
+#                     |  __//  \| |_) | (_| | |_
