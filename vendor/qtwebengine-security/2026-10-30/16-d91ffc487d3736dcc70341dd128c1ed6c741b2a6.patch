From d91ffc487d3736dcc70341dd128c1ed6c741b2a6 Mon Sep 17 00:00:00 2001
From: Shahbaz Youssefi <syoussefi@chromium.org>
Date: Tue, 15 Sep 2026 14:47:34 -0400
Subject: [PATCH] [Backport] CVE-2026-113266: Memory corruption in ANGLE

Manual cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/angle/angle/+/8415126:
Vulkan: Don't ghost images if base level has changed

Bug: b/560140367
Bug: chromium:561499641
Change-Id: Ib21dfece7075e00c5193214c06440e2c5f90ce91
Reviewed-on: https://chromium-review.googlesource.com/c/angle/angle/+/8415126
Reviewed-by: Charlie Lao <cclao@google.com>
Commit-Queue: Shahbaz Youssefi <syoussefi@chromium.org>
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/783829
Reviewed-by: Moss Heim <moss.heim@qt.io>
---
 .../angle/src/libANGLE/renderer/vulkan/TextureVk.cpp     | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/chromium/third_party/angle/src/libANGLE/renderer/vulkan/TextureVk.cpp b/chromium/third_party/angle/src/libANGLE/renderer/vulkan/TextureVk.cpp
index 337a35cc3c6..a49c9de7563 100644
--- a/chromium/third_party/angle/src/libANGLE/renderer/vulkan/TextureVk.cpp
+++ b/chromium/third_party/angle/src/libANGLE/renderer/vulkan/TextureVk.cpp
@@ -1158,6 +1158,9 @@ angle::Result TextureVk::ghostOnOverwrite(ContextVk *contextVk,
     }
 
     // Size check: Can only ghost the image if the area being overwritten covers the entire image.
+    // Base level check: If base level has changed, don't attempt to ghost it as
+    //                   getBaseLevelFormat() and initImage() will be wrong below, but also it's
+    //                   possible the texture has to be reallocated anyway later.
     //
     // As a targeted optimization, only limit to non-array 2D color textures.  Other texture types
     // can be very easily added if need, but need additional tests similar to those that have landed
@@ -1165,6 +1168,12 @@ angle::Result TextureVk::ghostOnOverwrite(ContextVk *contextVk,
     const gl::LevelIndex overwriteLevel = gl::LevelIndex(index.getLevelIndex());
     const gl::LevelIndex imageLevel     = mImage->getFirstAllocatedLevel();
 
+    const gl::LevelIndex baseLevel = gl::LevelIndex(mState.getBaseLevel());
+    if (baseLevel != imageLevel)
+    {
+        return angle::Result::Continue;
+    }
+
     const bool is2DImage = mImage->getLevelCount() == 1 && mImage->getLayerCount() == 1 &&
                            mImage->getType() == VK_IMAGE_TYPE_2D;
     const bool is2DUpdate  = mState.getType() == gl::TextureType::_2D && index.getLayerCount() == 1;
