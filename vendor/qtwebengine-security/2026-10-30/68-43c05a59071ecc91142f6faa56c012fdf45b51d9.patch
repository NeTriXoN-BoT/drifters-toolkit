 .../webaudio/realtime_audio_destination_handler.cc | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/chromium/third_party/blink/renderer/modules/webaudio/realtime_audio_destination_handler.cc b/chromium/third_party/blink/renderer/modules/webaudio/realtime_audio_destination_handler.cc
index 5c88dcb972ec..e260c728625a 100644
--- a/chromium/third_party/blink/renderer/modules/webaudio/realtime_audio_destination_handler.cc
+++ b/chromium/third_party/blink/renderer/modules/webaudio/realtime_audio_destination_handler.cc
@@ -254,14 +254,15 @@ void RealtimeAudioDestinationHandler::Render(
       // given `destination_bus` buffer.
       destination_bus->CopyFrom(*rendered_bus);
     }
+
+    // Processes "automatic" nodes that are not connected to anything. This can
+    // be done after copying because it does not affect the rendered result.
+    context->GetDeferredTaskHandler().ProcessAutomaticPullNodes(
+        number_of_frames);
   } else {
     destination_bus->Zero();
   }
 
-  // Processes "automatic" nodes that are not connected to anything. This can
-  // be done after copying because it does not affect the rendered result.
-  context->GetDeferredTaskHandler().ProcessAutomaticPullNodes(number_of_frames);
-
   context->HandlePostRenderTasks();
 
   // Handle audibility before handling the volume multiplier since the volume
@@ -454,7 +455,10 @@ void RealtimeAudioDestinationHandler::StopPlatformDestination() {
   // for a while. (It may take a bit of time for the destination to stop.)
   DisablePullingAudioGraph();
 
-  if (platform_destination_->IsPlaying()) {
+  // `AudioDestination::Stop()` is a no-op when already stopped, and transitions
+  // both `kRunning` and `kPaused` destinations to `kStopped` so a subsequent
+  // lifecycle `Resume()` cannot restart a stopped destination.
+  if (platform_destination_) {
     platform_destination_->Stop();
   }
 }
