@@ -344,16 +347,20 @@ const AstRawString* AstValueFactory::GetTwoByteStringInternal(
 const AstRawString* AstValueFactory::GetString(
     Tagged<String> literal,
     const SharedStringAccessGuardIfNeeded& access_guard) {
