From 0b78258dea4ed6e1b6a60726564d15a7ffbcf508 Mon Sep 17 00:00:00 2001
From: Sky Debreuil <skydebreuil@google.com>
Date: Fri, 9 Oct 2026 09:35:50 -0700
Subject: [Backport] CVE-2026-113279: Memory corruption in Accessibility

Cherry-pick of patch originally reviewed on
https://chromium-review.googlesource.com/c/chromium/src/+/8526087:
Mark image dirty directly when removing image map

When removing an HTMLMapElement during immediate tree updates, mark the
associated image AXObject's children dirty directly instead of calling
NotifyParentChildrenChanged mid-traversal.

Change-Id: Ia25df628d938a6bd48d17de46c9e716de847eefd
Bug: 570093145
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8526087
Reviewed-by: Lucas Radaelli <lucasradaelli@google.com>
Auto-Submit: Sky Debreuil <skydebreuil@google.com>
Reviewed-by: David Tseng <dtseng@chromium.org>
Commit-Queue: Sky Debreuil <skydebreuil@google.com>
Commit-Queue: David Tseng <dtseng@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1715691}
Reviewed-on: https://codereview.qt-project.org/c/qt/qtwebengine-chromium/+/782968
Reviewed-by: Moss Heim <moss.heim@qt.io>
---
 .../blink/renderer/modules/accessibility/ax_object_cache_impl.cc | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/chromium/third_party/blink/renderer/modules/accessibility/ax_object_cache_impl.cc b/chromium/third_party/blink/renderer/modules/accessibility/ax_object_cache_impl.cc
index a7c74658174..58a092820b6 100644
--- a/chromium/third_party/blink/renderer/modules/accessibility/ax_object_cache_impl.cc
+++ b/chromium/third_party/blink/renderer/modules/accessibility/ax_object_cache_impl.cc
@@ -2078,7 +2078,14 @@ void AXObjectCacheImpl::RemoveSubtree(const Node* node,
       // **important**: this call must come before the node traversal remove
       // below since that could remove a child which would cause it to not point
       // to its image parent, making it impossible to notify the parent.
-      NotifyParentChildrenChanged(image_ax_object);
+      if (lifecycle_.GetState() ==
+          AXObjectCacheLifecycle::kProcessDeferredUpdates) {
+        if (AXObject* ancestor = InvalidateChildren(image_ax_object)) {
+          ancestor->ChildrenChangedWithCleanLayout();
+        }
+      } else {
+        NotifyParentChildrenChanged(image_ax_object);
+      }
     }
   }
 
