@@ -530,8 +531,6 @@ class ContextMtl : public ContextImpl, public mtl::Context
 
     angle::Result startOcclusionQueryInRenderPass(QueryMtl *query, bool clearOldValue);
 
-    angle::Result checkCommandBufferError();
-
     // Dirty bits.
     enum DirtyBitType : size_t
     {
@@ -646,6 +645,8 @@ class ContextMtl : public ContextImpl, public mtl::Context
     ProvokingVertexHelper mProvokingVertexHelper;
 
     mtl::ContextDevice mContextDevice;
+
+    bool mContextLost = false;
 };
 
 }  // namespace rx
diff --git a/chromium/third_party/angle/src/libANGLE/renderer/metal/ContextMtl.mm b/chromium/third_party/angle/src/libANGLE/renderer/metal/ContextMtl.mm
index e1962371c24..e7a26e223a4 100644
--- a/chromium/third_party/angle/src/libANGLE/renderer/metal/ContextMtl.mm
+++ b/chromium/third_party/angle/src/libANGLE/renderer/metal/ContextMtl.mm
@@ -1070,6 +1070,10 @@ GLint GetOwnershipIdentity(const egl::AttributeMap &attribs)
 // Device loss
 gl::GraphicsResetStatus ContextMtl::getResetStatus()
 {
+    if (mContextLost)
+    {
+        return gl::GraphicsResetStatus::UnknownContextReset;
+    }
     return gl::GraphicsResetStatus::NoError;
 }
 
@@ -2978,9 +2982,19 @@ static bool isDrawNoOp(const mtl::RenderPipelineDesc &descriptor,
 
 angle::Result ContextMtl::checkCommandBufferError()
 {
-    ANGLE_CHECK_GL_ALLOC(
-        this, mCmdBuffer.cmdQueue().popCmdBufferError() != MTLCommandBufferErrorOutOfMemory);
-    return angle::Result::Continue;
+    switch (mCmdBuffer.cmdQueue().popCmdBufferError())
+    {
+        case MTLCommandBufferErrorNone:
+            return angle::Result::Continue;
+        case MTLCommandBufferErrorOutOfMemory:
+            ANGLE_CHECK_GL_ALLOC(this, false);
+            return angle::Result::Stop;
+        default:
+            mContextLost = true;
+            ANGLE_CHECK(this, false, "Metal command buffer execution failed.",
+                        GL_INVALID_OPERATION);
+            return angle::Result::Stop;
+    }
 }
 
 }  // namespace rx
diff --git a/chromium/third_party/angle/src/libANGLE/renderer/metal/FrameBufferMtl.mm b/chromium/third_party/angle/src/libANGLE/renderer/metal/FrameBufferMtl.mm
index 7747395f681..4c5e78eaf42 100644
--- a/chromium/third_party/angle/src/libANGLE/renderer/metal/FrameBufferMtl.mm
+++ b/chromium/third_party/angle/src/libANGLE/renderer/metal/FrameBufferMtl.mm
