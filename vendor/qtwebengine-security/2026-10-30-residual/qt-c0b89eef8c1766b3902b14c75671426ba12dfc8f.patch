         buffer->syncContent(contextMtl, contextMtl->getBlitCommandEncoder());
         const uint8_t *bufferData = buffer->mapReadOnly(contextMtl);
+        // Verify that the command buffer (including any pending clears/draws and the readback
+        // blit) executed without GPU faults before reading back the buffer contents.
+        ANGLE_TRY(contextMtl->checkCommandBufferError());
 
         angle::Result result = readPixelsCopyImpl(
             context, area, packPixelsParams, renderTarget,
@@ -1652,6 +1655,8 @@ void RoundValueAndAdjustCorrespondingValue(float a,
     {
         contextMtl->flushCommandBuffer(mtl::WaitUntilFinished);
     }
+    // Verify that prior command buffers affecting this texture completed without GPU faults.
+    ANGLE_TRY(contextMtl->checkCommandBufferError());
 
     angle::MemoryBuffer readPixelRowBuffer;
     int bufferRowPitch = area.width * readAngleFormat.pixelBytes;
diff --git a/chromium/third_party/angle/src/libANGLE/renderer/metal/mtl_command_buffer.h b/chromium/third_party/angle/src/libANGLE/renderer/metal/mtl_command_buffer.h
index 8bcb245d2b4..f4cadf7aab9 100644
--- a/chromium/third_party/angle/src/libANGLE/renderer/metal/mtl_command_buffer.h
+++ b/chromium/third_party/angle/src/libANGLE/renderer/metal/mtl_command_buffer.h
@@ -58,7 +58,7 @@ class AtomicSerial : angle::NonCopyable
 class AtomicCommandBufferError : angle::NonCopyable
 {
   public:
-    void store(MTLCommandBufferError value) { mValue.store(value, std::memory_order_release); }
+    void store(MTLCommandBufferError value);
     MTLCommandBufferError pop()
     {
         return mValue.exchange(MTLCommandBufferErrorNone, std::memory_order_acq_rel);
diff --git a/chromium/third_party/angle/src/libANGLE/renderer/metal/mtl_command_buffer.mm b/chromium/third_party/angle/src/libANGLE/renderer/metal/mtl_command_buffer.mm
index ef26a5f401c..3cefe1b9a2c 100644
--- a/chromium/third_party/angle/src/libANGLE/renderer/metal/mtl_command_buffer.mm
+++ b/chromium/third_party/angle/src/libANGLE/renderer/metal/mtl_command_buffer.mm
@@ -480,6 +480,21 @@ void RandomizeClearValue(ObjCAttachmentDescriptor *objCRenderPassAttachment)
     }
 }
 
+// AtomicCommandBufferError implementation
+void AtomicCommandBufferError::store(MTLCommandBufferError value)
+{
+    // Do not overwrite an existing non-OOM GPU fault error (e.g. Timeout, PageFault,
+    // DeviceRemoved) with a subsequent error (such as NotPermitted from rejected follow-up
+    // submissions or OutOfMemory) so the root-cause fault is preserved until popped.
+    MTLCommandBufferError prevError = mValue.load(std::memory_order_relaxed);
+    while (
+        (prevError == MTLCommandBufferErrorNone || prevError == MTLCommandBufferErrorOutOfMemory) &&
+        !mValue.compare_exchange_weak(prevError, value, std::memory_order_release,
+                                      std::memory_order_consume))
+    {
+    }
+}
+
 // CommandQueue implementation
 void CommandQueue::reset()
 {
