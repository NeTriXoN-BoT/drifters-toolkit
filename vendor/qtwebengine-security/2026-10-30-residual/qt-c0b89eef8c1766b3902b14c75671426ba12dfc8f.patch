diff --git a/chromium/third_party/angle/src/libANGLE/renderer/metal/BufferMtl.mm b/chromium/third_party/angle/src/libANGLE/renderer/metal/BufferMtl.mm
index 22f065c9a0d..c781fd2ae29 100644
--- a/chromium/third_party/angle/src/libANGLE/renderer/metal/BufferMtl.mm
+++ b/chromium/third_party/angle/src/libANGLE/renderer/metal/BufferMtl.mm
@@ -210,16 +210,19 @@ bool isOffsetAndSizeMetalBlitCompatible(size_t offset, size_t size)
     if (mapPtr)
     {
         ContextMtl *contextMtl = mtl::GetImpl(context);
+        uint8_t *ptr           = nullptr;
         if (mShadowCopy.size() == 0)
         {
-            *mapPtr = mBuffer->mapWithOpt(contextMtl, (access & GL_MAP_WRITE_BIT) == 0,
+            ptr = mBuffer->mapWithOpt(contextMtl, (access & GL_MAP_WRITE_BIT) == 0,
                                           access & GL_MAP_UNSYNCHRONIZED_BIT) +
                       offset;
         }
         else
         {
-            *mapPtr = syncAndObtainShadowCopy(contextMtl) + offset;
+            ptr = syncAndObtainShadowCopy(contextMtl) + offset;
         }
+        ANGLE_TRY(contextMtl->checkCommandBufferError());
+        *mapPtr = ptr;
     }
 
     return angle::Result::Continue;
diff --git a/chromium/third_party/angle/src/libANGLE/renderer/metal/ContextMtl.h b/chromium/third_party/angle/src/libANGLE/renderer/metal/ContextMtl.h
